# Deploy to Cloudflare reads this file to show both secrets in the setup form.
# Create a GitHub OAuth App at https://github.com/settings/developers.
# Homepage URL: https://<worker-name>.<workers-subdomain>.workers.dev
# Callback URL: https://<worker-name>.<workers-subdomain>.workers.dev/v1/auth/github/callback
# Use the same OAuth App for both values. Do not commit real credentials here.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
